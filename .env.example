# Swiss Broker MCP - Environment Variables
# Kopiere diese Datei nach .env und fuelle die Werte aus.
# .env ist in .gitignore und wird NICHT committet.

# --- Server ---
# Port auf dem der MCP Server lauscht (Cloud Run setzt $PORT automatisch).
PORT=8080

# Log-Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- HTTP Client ---
# Timeout in Sekunden fuer externe API Calls (opendata.swiss, BFS, Nominatim).
HTTP_TIMEOUT_SECONDS=15

# User-Agent fuer Nominatim (Pflicht laut OSM Usage Policy).
# Format: "AppName/Version (kontakt@example.com)"
NOMINATIM_USER_AGENT=swiss-broker-mcp/0.1 (contact@example.com)

# --- Cache ---
# TTL fuer In-Memory Cache in Sekunden (default 3600 = 1h).
CACHE_TTL_SECONDS=3600

# --- Optional: Externe Quellen ---
# Falls spaeter eigene Daten-APIs angebunden werden.
# OPENDATA_SWISS_API_KEY=
